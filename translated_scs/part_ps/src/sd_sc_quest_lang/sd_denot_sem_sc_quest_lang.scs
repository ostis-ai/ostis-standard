	(*
		<- lang_ru;;
		=> nrel_format: format_html;;
	*);
	<= nrel_inclusion: knowledge;;

	.system_element_6919
	=> nrel_note: [<p>Среди всех классов <i>знаков в рамках заданного вопроса</i> <i>Языка вопросов для ostis-систем</i> можно выделить наиболее общие по иерархии классы <i>знаков</i>.</p>]
	(*
