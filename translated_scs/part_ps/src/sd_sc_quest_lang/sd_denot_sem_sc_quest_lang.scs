	*);;

	.system_element_6953
	=> nrel_idtf: [<p>устойчивая комбинация двух <i>отношений действия</i>: действия, направленного на <i>параметр вопроса'</i>, и действия, направленного на <i>ответ на вопрос*</i></p>]
	(*
