	.system_element_6923
	=> nrel_idtf: [<p><i>класс отношений</i>, объединяющий <i>отношения в заданном вопросе</i>, отражающие однотипный <i>смысл</i> и раскрывающие определенный признак <i>знаков</i> <i>предметной области</i></p>]
